# Postgres. Con docker compose, estos datos coinciden con el servicio `db`.
DATABASE_URL=postgres://vitrina:vitrina@localhost:5432/vitrina

# Secreto para la sesión del admin. Cambialo en cada cliente.
JWT_SECRET=cambia-este-secreto-por-uno-largo

# Primer usuario de administración. El seed lo crea solo si todavía no existe.
ADMIN_EMAIL=admin@vitrina.local
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NAME=Admin

PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Dejá las claves vacías para usar el pago de demostración dentro de la página.
# Cuando un cliente tenga Stripe, completa las tres y reiniciá la API.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Vacío en desarrollo: Vite proxea /api y /uploads, así el teléfono puede
# abrir el admin por la IP de la compu. En producción, la URL pública de la API.
VITE_API_URL=
